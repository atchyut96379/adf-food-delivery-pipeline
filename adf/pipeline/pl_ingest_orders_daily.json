{
	"name": "pl_ingest_orders_daily",
	"properties": {
		"activities": [
			{
				"name": "CheckOrdersFile",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_orders_csv",
						"type": "DatasetReference",
						"parameters": {
							"batch_date": {
								"value": "@pipeline().parameters.batch_date",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "CheckOrdersFile",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('CheckOrdersFile').output.exists",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "ORDERS_FILE_NOT_FOUND",
							"description": "The orders.csv file is missing for the requested batch date.",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "The orders.csv file is missing for the requested batch date.",
								"errorCode": "ORDERS_FILE_NOT_FOUND"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "CopyOrdersToParquet",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_orders_csv",
									"type": "DatasetReference",
									"parameters": {
										"batch_date": {
											"value": "@pipeline().parameters.batch_date",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_orders_parquet",
									"type": "DatasetReference",
									"parameters": {
										"batch_date": {
											"value": "@pipeline().parameters.batch_date",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"batch_date": {
				"type": "string"
			}
		},
		"annotations": []
	}
}